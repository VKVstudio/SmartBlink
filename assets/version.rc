// SmartBlink resources: icon, manifest, version info. Compiled by build.rs via windres.
#include <windows.h>

101 ICON "icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x2L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "VKV Studio"
            VALUE "FileDescription", "SmartBlink (Beta) - wrong-layout typing alert and one-gesture fix"
            VALUE "FileVersion", "0.1.0-beta"
            VALUE "InternalName", "smartblink"
            VALUE "LegalCopyright", "MIT License - Copyright (c) 2026 VKV Studio"
            VALUE "OriginalFilename", "smartblink.exe"
            VALUE "ProductName", "SmartBlink"
            VALUE "ProductVersion", "0.1.0-beta"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
